# Copier ce fichier en .env.local et remplir les valeurs. Ne jamais committer .env.local.

# Supabase - projet « LM CRM » (région Europe)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Serveur uniquement
SUPABASE_SECRET_KEY=sb_secret_xxx
# Connexion PostgreSQL via le Session pooler (Supabase > Connect > Session pooler)
DATABASE_URL=postgresql://postgres.xxxxxxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# Accès à l'application (identifiant / mot de passe demandés par le navigateur)
APP_USER=louis
APP_PASSWORD=change-moi

# Jeton du formulaire public d'ajout de prospect : /formulaire/<FORM_TOKEN>
# Générer une valeur longue, par ex. : openssl rand -hex 16
FORM_TOKEN=change-moi-aussi

# Module leads (Python) : clé API Google Places (API « Places API (New) »)
GOOGLE_PLACES_API_KEY=
